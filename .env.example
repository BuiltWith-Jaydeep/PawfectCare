# ─────────────────────────────────────────────────────────────
# PawfectCare — FRONTEND environment
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# ⚠️  EVERYTHING HERE IS PUBLIC.
# Create React App compiles these values into the JavaScript bundle
# that ships to every visitor's browser. Anyone can read them.
# Only ever put PUBLISHABLE / non-secret values in this file.
# Never a Stripe secret key (sk_...), never a database URI, never a JWT secret.
#
# Variables MUST be prefixed REACT_APP_ or CRA ignores them.
# CRA reads this file only at startup — restart `npm start` after editing.
# ─────────────────────────────────────────────────────────────

# Base URL of the backend API (no trailing slash).
# Local: http://localhost:5000     Deployed: https://your-api-host
REACT_APP_API_URL=http://localhost:5000

# Stripe PUBLISHABLE key — starts with pk_test_ (safe to expose by design).
# Dashboard → Developers → API keys → "Publishable key".
REACT_APP_STRIPE_PUBLISHABLE_KEY=
