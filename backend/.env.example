# ─────────────────────────────────────────────────────────────
# PawfectCare — BACKEND environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# See docs/SETUP.md for where each value comes from.
# ─────────────────────────────────────────────────────────────

# API port
PORT=5000

# MongoDB Atlas connection string.
#   cloud.mongodb.com → Connect → Drivers → Node.js
#   Replace <password> with your DB user's password and keep the
#   /pawfectcare database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pawfectcare?retryWrites=true&w=majority

# JWT signing secret — 32+ random bytes. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Stripe TEST secret key (dashboard → Developers → API keys).
# Must start with sk_test_. Never a live key (sk_live_) in this project.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret.
# Local: run `stripe listen --forward-to http://localhost:5000/api/webhook`
#        and copy the whsec_... it prints. It CHANGES on every restart.
# Deployed: Stripe dashboard → Developers → Webhooks → your endpoint.
STRIPE_WEBHOOK_SECRET=

# Allowed CORS origin (the frontend URL).
CLIENT_URL=http://localhost:3000

# Used ONCE by `npm run seed` to create the initial admin account.
# Remove these after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: set if you get "querySrv ECONNREFUSED"
# DNS_SERVERS=8.8.8.8,1.1.1.1
